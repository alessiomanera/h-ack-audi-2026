* text=auto eol=lf

# Session history: up to 3 people append at the same time.
# The union driver keeps both sides' lines, so merges never conflict.
HISTORY.md merge=union

# Never hand-merge the lockfile: take theirs, then run npm install.
package-lock.json -diff linguist-generated=true

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.woff2 binary
